// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(cuid())
  name      String
  columns   Column[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Column {
  id       String @id @default(cuid())
  name     String
  position Int
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  priority    String    @default("medium")
  position    Int
  startDate   DateTime?
  dueDate     DateTime?
  isArchived  Boolean   @default(false)
  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  tags        Tag[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subtask {
  id       String  @id @default(cuid())
  title    String
  done     Boolean @default(false)
  position Int
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6B7280")
  tasks Task[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(512)

  @@index([expiresAt])
}

enum AccountRegion {
  ARGENTINA
  AUSTRALIA
  GLOBAL
}

enum AccountGroupType {
  BANK
  WALLET
  CARD
  OTHER
}

enum LedgerAccountKind {
  ASSET
  LIABILITY
  RECEIVABLE
  PAYABLE
  INCOME
  EXPENSE
  EQUITY
  CLEARING
}

enum LedgerAccountSubtype {
  BANK
  WALLET
  CARD
  OPENING
  ADJUSTMENT
  FX
  PERSON
  OTHER
}

enum AccountTrackingMode {
  TRANSACTIONAL
  DECLARED
}

enum JournalOperationType {
  INCOME
  EXPENSE
  TRANSFER
  FX
  CARD_PURCHASE
  CARD_PAYMENT
  LOAN
  SETTLEMENT
  OPENING_BALANCE
  ADJUSTMENT
  REVERSAL
  SHARED_EXPENSE
  PERSON_SETTLEMENT
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

enum JournalEntrySource {
  MANUAL
  SYSTEM
  REVOLUT_API
}

enum PostingSide {
  DEBIT
  CREDIT
}

enum JournalAuditField {
  DESCRIPTION
  CATEGORY
}

enum ObligationDirection {
  RECEIVABLE
  PAYABLE
}

enum ObligationOriginType {
  ACCOUNT_MOVEMENT
  OPENING_BALANCE
}

enum CategoryRuleSource {
  USER_CONFIRMED
}

enum RecurringFrequency {
  ONCE
  WEEKLY
  MONTHLY
}

enum RecurringCommitmentStatus {
  ACTIVE
  CANCELLED
}

model AccountGroup {
  id        String           @id @default(cuid())
  name      String
  region    AccountRegion
  type      AccountGroupType
  isActive  Boolean          @default(true)
  accounts  LedgerAccount[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model LedgerAccount {
  id                   String                @id @default(cuid())
  accountGroupId       String?
  name                 String
  currency             String                @db.Char(3)
  kind                 LedgerAccountKind
  subtype              LedgerAccountSubtype
  trackingMode         AccountTrackingMode   @default(TRANSACTIONAL)
  isSystem             Boolean               @default(false)
  isActive             Boolean               @default(true)
  personId             String?
  accountGroup         AccountGroup?         @relation(fields: [accountGroupId], references: [id], onDelete: Restrict)
  person               Person?               @relation(fields: [personId], references: [id], onDelete: Restrict)
  postings             Posting[]
  recurringCommitments RecurringCommitment[]
  walletCardAliases    WalletCardAlias[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([accountGroupId, currency])
  @@unique([personId, currency])
  @@index([kind, currency])
}

/// Someone you share expenses with. One RECEIVABLE/PERSON ledger account per currency, created on demand.
model Person {
  id         String          @id @default(cuid())
  name       String
  archivedAt DateTime?
  accounts   LedgerAccount[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model JournalEntry {
  id                     String                              @id @default(cuid())
  operationType          JournalOperationType
  status                 JournalEntryStatus                  @default(POSTED)
  source                 JournalEntrySource
  occurredOn             DateTime                            @db.Date
  description            String
  idempotencyKey         String?
  reversalOfId           String?                             @unique
  metadata               Json?
  reversalOf             JournalEntry?                       @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy             JournalEntry?                       @relation("JournalReversal")
  postings               Posting[]
  auditEvents            JournalEntryAudit[]
  exchangeRateReferences JournalEntryExchangeRateReference[]
  originatedObligation   Obligation?                         @relation("ObligationOriginEntry")
  obligationSettlement   ObligationSettlement?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt

  @@unique([source, idempotencyKey])
  @@index([occurredOn, status])
}

model ExchangeRateSnapshot {
  id                     String                              @id @default(cuid())
  baseCurrency           String                              @db.Char(3)
  quoteCurrency          String                              @db.Char(3)
  rate                   Decimal                             @db.Decimal(18, 8)
  provider               String
  observedAt             DateTime
  appliedOn              DateTime                            @db.Date
  isManualOverride       Boolean                             @default(false)
  journalEntryReferences JournalEntryExchangeRateReference[]
  createdAt              DateTime                            @default(now())

  @@unique([baseCurrency, quoteCurrency, provider, observedAt, isManualOverride])
  @@index([baseCurrency, quoteCurrency, appliedOn, observedAt])
}

model JournalEntryExchangeRateReference {
  journalEntryId String
  snapshotId     String
  journalEntry   JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  snapshot       ExchangeRateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@id([journalEntryId, snapshotId])
  @@index([snapshotId])
}

model FinanceConfiguration {
  id           String   @id @default("default")
  baseCurrency String   @default("USD") @db.Char(3)
  updatedAt    DateTime @updatedAt
}

model EnabledCurrency {
  code      String   @id @db.Char(3)
  createdAt DateTime @default(now())
}

model Posting {
  id              String        @id @default(cuid())
  journalEntryId  String
  ledgerAccountId String
  side            PostingSide
  amount          Decimal       @db.Decimal(18, 2)
  categoryId      String?
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@index([journalEntryId])
  @@index([ledgerAccountId])
  @@index([categoryId])
}

model JournalEntryAudit {
  id             String            @id @default(cuid())
  journalEntryId String
  field          JournalAuditField
  previousValue  String?
  newValue       String?
  journalEntry   JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([journalEntryId, createdAt])
}

model Obligation {
  id             String                 @id @default(cuid())
  direction      ObligationDirection
  originType     ObligationOriginType
  counterparty   String
  description    String
  currency       String                 @db.Char(3)
  originalAmount Decimal                @db.Decimal(18, 2)
  dueOn          DateTime?              @db.Date
  originEntryId  String?                @unique
  originEntry    JournalEntry?          @relation("ObligationOriginEntry", fields: [originEntryId], references: [id], onDelete: Restrict)
  settlements    ObligationSettlement[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([direction, currency])
  @@index([dueOn])
}

model ObligationSettlement {
  id             String       @id @default(cuid())
  obligationId   String
  journalEntryId String       @unique
  amount         Decimal      @db.Decimal(18, 2)
  obligation     Obligation   @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@index([obligationId, createdAt])
}

model CategoryRule {
  id                String             @id @default(cuid())
  patternNormalized String
  categoryId        String
  priority          Int                @default(0)
  source            CategoryRuleSource @default(USER_CONFIRMED)
  lastUsedAt        DateTime?
  isActive          Boolean            @default(true)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([patternNormalized, categoryId])
  @@index([isActive, priority])
}

model RecurringCommitment {
  id                String                    @id @default(cuid())
  name              String
  expectedAmount    Decimal                   @db.Decimal(18, 2)
  currency          String                    @db.Char(3)
  frequency         RecurringFrequency
  startsOn          DateTime                  @db.Date
  endsOn            DateTime?                 @db.Date
  categoryId        String?
  expectedAccountId String?
  status            RecurringCommitmentStatus @default(ACTIVE)
  cancelledAt       DateTime?
  category          Category?                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expectedAccount   LedgerAccount?            @relation(fields: [expectedAccountId], references: [id], onDelete: Restrict)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([status, startsOn, endsOn])
}

model Category {
  id                   String                @id @default(cuid())
  name                 String
  color                String                @default("#6B7280")
  createdAt            DateTime              @default(now())
  postings             Posting[]
  categoryRules        CategoryRule[]
  recurringCommitments RecurringCommitment[]
}

model WalletCardAlias {
  id              String        @id @default(cuid())
  label           String
  aliasNormalized String        @unique
  ledgerAccountId String
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ledgerAccountId])
}
