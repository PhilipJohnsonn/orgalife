// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(cuid())
  name      String
  columns   Column[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Column {
  id       String @id @default(cuid())
  name     String
  position Int
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  priority    String    @default("medium")
  position    Int
  startDate   DateTime?
  dueDate     DateTime?
  isArchived  Boolean   @default(false)
  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  tags        Tag[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subtask {
  id       String  @id @default(cuid())
  title    String
  done     Boolean @default(false)
  position Int
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6B7280")
  tasks Task[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(512)

  @@index([expiresAt])
}

enum AccountRegion {
  ARGENTINA
  AUSTRALIA
  GLOBAL
}

enum AccountGroupType {
  BANK
  WALLET
  CARD
  OTHER
}

enum LedgerAccountKind {
  ASSET
  LIABILITY
  RECEIVABLE
  PAYABLE
  INCOME
  EXPENSE
  EQUITY
  CLEARING
}

enum LedgerAccountSubtype {
  BANK
  WALLET
  CARD
  OPENING
  ADJUSTMENT
  FX
  OTHER
}

enum AccountTrackingMode {
  TRANSACTIONAL
  DECLARED
}

enum JournalOperationType {
  INCOME
  EXPENSE
  TRANSFER
  FX
  CARD_PURCHASE
  CARD_PAYMENT
  LOAN
  SETTLEMENT
  OPENING_BALANCE
  ADJUSTMENT
  REVERSAL
}

enum JournalEntryStatus {
  POSTED
  PROVISIONAL
  SUPERSEDED
  DISMISSED
  REVERSED
}

enum JournalEntrySource {
  MANUAL
  CARD_STATEMENT
  SYSTEM
  REVOLUT_API
}

enum PostingSide {
  DEBIT
  CREDIT
}

enum JournalAuditField {
  DESCRIPTION
  CATEGORY
}

model AccountGroup {
  id        String           @id @default(cuid())
  name      String
  region    AccountRegion
  type      AccountGroupType
  isActive  Boolean          @default(true)
  accounts  LedgerAccount[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model LedgerAccount {
  id             String               @id @default(cuid())
  accountGroupId String?
  name           String
  currency       String               @db.Char(3)
  kind           LedgerAccountKind
  subtype        LedgerAccountSubtype
  trackingMode   AccountTrackingMode  @default(TRANSACTIONAL)
  isSystem       Boolean              @default(false)
  isActive       Boolean              @default(true)
  accountGroup   AccountGroup?        @relation(fields: [accountGroupId], references: [id], onDelete: Restrict)
  postings       Posting[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([accountGroupId, currency])
  @@index([kind, currency])
}

model JournalEntry {
  id             String               @id @default(cuid())
  operationType  JournalOperationType
  status         JournalEntryStatus   @default(POSTED)
  source         JournalEntrySource
  occurredOn     DateTime             @db.Date
  description    String
  idempotencyKey String?
  reversalOfId   String?              @unique
  metadata       Json?
  reversalOf     JournalEntry?        @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     JournalEntry?        @relation("JournalReversal")
  postings       Posting[]
  auditEvents    JournalEntryAudit[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([source, idempotencyKey])
  @@index([occurredOn, status])
}

model Posting {
  id              String        @id @default(cuid())
  journalEntryId  String
  ledgerAccountId String
  side            PostingSide
  amount          Decimal       @db.Decimal(18, 2)
  categoryId      String?
  statementLineId String?
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@index([journalEntryId])
  @@index([ledgerAccountId])
  @@index([categoryId])
  @@index([statementLineId])
}

model JournalEntryAudit {
  id             String            @id @default(cuid())
  journalEntryId String
  field          JournalAuditField
  previousValue  String?
  newValue       String?
  journalEntry   JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([journalEntryId, createdAt])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
}

model FinancialAccount {
  id           String        @id @default(cuid())
  name         String
  currencies   String[]
  color        String        @default("#6B7280")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model CardStatement {
  id        String        @id @default(cuid())
  cardName  String
  amountUSD Float?
  amountARS Float?
  dueDate   DateTime?
  isPaid    Boolean       @default(false)
  rawText   String?       @db.Text
  createdAt DateTime      @default(now())
  expenses  CardExpense[]
}

model CardExpense {
  id               String        @id @default(cuid())
  statementId      String
  description      String
  purchaseDate     DateTime?
  installmentInfo  String?
  originalCurrency String?
  originalAmount   Float?
  amountARS        Float?
  amountUSD        Float?
  isExcluded       Boolean       @default(false)
  excludeReason    String?
  statement        CardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  transaction      Transaction?
}

model Debt {
  id          String    @id @default(cuid())
  description String
  creditor    String?
  amountUSD   Float?
  amountARS   Float?
  isIncluded  Boolean   @default(true)
  isPaid      Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

model Category {
  id           String        @id @default(cuid())
  name         String
  color        String        @default("#6B7280")
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  postings     Posting[]
}

model Transaction {
  id            String            @id @default(cuid())
  type          TransactionType
  description   String
  amount        Float
  currency      String
  amountUSD     Float?
  date          DateTime
  isRecurring   Boolean           @default(false)
  method        PaymentMethod     @default(CASH)
  cardName      String?
  accountId     String?
  categoryId    String?
  cardExpenseId String?           @unique
  account       FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cardExpense   CardExpense?      @relation(fields: [cardExpenseId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}
